# 签名密钥配置模板
#
# 用法：复制本文件为 keystore.properties（该文件已被 .gitignore 排除），填入真实路径与密码。
#       cp keystore.properties.example keystore.properties
#
# 未配置时，Gradle 会自动回落到 Android 默认 debug keystore，
# 依然可以正常 assembleDebug / assembleRelease（产出为未签名或用 debug 签名）。
#
# ⚠️ 切勿把真实的 keystore.properties 或 .jks 文件提交到 Git。

storeFile=keystore/watch-release.jks
storePassword=<你的密钥库密码>
keyAlias=watch
keyPassword=<你的私钥密码>
